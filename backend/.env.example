# Copy to backend/.env and fill in. Never commit the real .env file.
ENVIRONMENT=development

# SQLite (current, local development):
DATABASE_URL=sqlite:///./ebms_local.db
# PostgreSQL (planned, for deployment):
# DATABASE_URL=postgresql+psycopg2://ebms:ebms_password@localhost:5432/ebms

# Generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=120
BCRYPT_ROUNDS=12
LOGIN_RATE_LIMIT=5
LOGIN_RATE_WINDOW_SECONDS=300

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173

# Create tables at startup (local only). Production: false + `alembic upgrade head`.
AUTO_CREATE_TABLES=true

# Email (off by default - messages are only noted in logs/app.log)
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_FROM=no-reply@example.com

# Shows the password-reset link on screen when email is off. Ignored in production.
DEV_SHOW_RESET_LINK=true
LOG_LEVEL=INFO
